# CORE
SECRET_KEY=change-me-to-a-random-string
ENCRYPTION_KEY_SALT=change-me-to-a-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
APP_URL=http://localhost:8000

# DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campaign_os

# REDIS — Celery broker + result backend (and Django cache).
# REQUIRED in any environment that runs the celery worker/beat services.
# The broker is forced to logical DB /1 (see config/celery.py); the cache
# uses the URL as given. When unset, Celery falls back to
# redis://localhost:6379/1, which only works if a local Redis is running.
# docker-compose: defaults to the bundled redis service (redis://redis:6379/0).
REDIS_URL=redis://localhost:6379/0

# STORAGE
STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_CUSTOM_DOMAIN=
S3_REGION_NAME=auto

# EMAIL
EMAIL_BACKEND_TYPE=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# GOOGLE AUTH (user login/signup - separate from platform credentials below)
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# GOOGLE SHEETS SYNC (content intake)
# Run scripts/get_google_refresh_token.py once to get these three values.
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REFRESH_TOKEN=
# Legacy alternative: service-account JSON (one line). Used only if OAuth2 vars above are unset.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
CONTENT_INTAKE_SHEET_ID=1cHFwSI-W2B_sXMewVVUhPQJ16ZtFONGJl2OQux7UqJE
CONTENT_INTAKE_SHEET_RANGE=Sheet1!A:P

# PLATFORM CREDENTIALS (cloud version - self-hosted uses admin UI)
PLATFORM_FACEBOOK_APP_ID=
PLATFORM_FACEBOOK_APP_SECRET=
PLATFORM_INSTAGRAM_APP_ID=
PLATFORM_INSTAGRAM_APP_SECRET=
# LinkedIn - see README "LinkedIn" section. Choose Path A or Path B (or both).
# Path B (Community Management API) credentials are automatically reused for
# personal connections, giving refresh tokens + inbox.
PLATFORM_LINKEDIN_PERSONAL_CLIENT_ID=
PLATFORM_LINKEDIN_PERSONAL_CLIENT_SECRET=
PLATFORM_LINKEDIN_COMPANY_CLIENT_ID=
PLATFORM_LINKEDIN_COMPANY_CLIENT_SECRET=
# Legacy shared vars (still honored as fallback for both personal + company,
# assumed to be CM-approved). Leave commented unless migrating from an older install.
# PLATFORM_LINKEDIN_CLIENT_ID=
# PLATFORM_LINKEDIN_CLIENT_SECRET=
PLATFORM_TWITTER_CLIENT_ID=
PLATFORM_TWITTER_CLIENT_SECRET=
PLATFORM_TIKTOK_CLIENT_KEY=
PLATFORM_TIKTOK_CLIENT_SECRET=
PLATFORM_GOOGLE_CLIENT_ID=
PLATFORM_GOOGLE_CLIENT_SECRET=
PLATFORM_PINTEREST_APP_ID=
PLATFORM_PINTEREST_APP_SECRET=
# Ghost (Nexus Brief) - single org-level Admin API key (id:secret), no OAuth.
# Ghost Admin -> Settings -> Integrations -> Custom integration. Newsletter slug
# is optional and only needed for email-only sends.
GHOST_ADMIN_API_KEY=
GHOST_BASE_URL=https://the-nexus-brief.ghost.io
GHOST_NEWSLETTER_SLUG=


# INBOUND WEBHOOKS
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_LOGIN_WEBHOOK_VERIFY_TOKEN=
YOUTUBE_WEBHOOK_SECRET=

# INTELLIGENCE — optional hosted SaaS integration.
# All five vars must be set for the Intelligence menu item / billing flow
# to appear. Leave any blank to keep Studio in vanilla OSS mode (no Stripe,
# no left-nav Intelligence entry, no /orgs/<id>/intelligence/ URLs).
# - INTELLIGENCE_INTERNAL_URL: hosted Intelligence's /internal/v1/ base
# - INTELLIGENCE_PUBLIC_URL:   hosted Intelligence's /v1/ base
# - STUDIO_DEPLOYMENT_ID:      must match the value registered on the
#                              Intelligence side via register_studio_deployment
# - STUDIO_SHARED_SECRET:      HMAC secret for this deployment (Intelligence-issued)
# - STUDIO_BASE_URL:           https:// URL of THIS Studio deployment.
#                              Validated at boot — non-https raises
#                              ImproperlyConfigured.
INTELLIGENCE_INTERNAL_URL=
INTELLIGENCE_PUBLIC_URL=
STUDIO_DEPLOYMENT_ID=
STUDIO_SHARED_SECRET=
STUDIO_BASE_URL=

# AGENT-SERVICE gate client — base URL of the agent-service exposing
# GET /gate/verify/{id}. Publish-gate requests are HMAC-signed with
# STUDIO_SHARED_SECRET and identified by STUDIO_DEPLOYMENT_ID.
AGENT_SERVICE_BASE_URL=
# Bearer token for the shared console agent-service client (JWT of a
# dedicated 'platform' agent-service user).
AGENT_SERVICE_TOKEN=

# CONTENT INTAKE — Google Sheets sync (Task 7)
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON: full JSON of a GCP service-account key
#   that has been granted Viewer access to the planning sheet.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
CONTENT_INTAKE_SHEET_ID=
CONTENT_INTAKE_SHEET_RANGE=Sheet1!A:P
# DEFERRED: sheet write-back (updating the Status column after publish) is not
# yet implemented.  Keep this false until the writeback path is built.
CONTENT_INTAKE_WRITEBACK_ENABLED=false

